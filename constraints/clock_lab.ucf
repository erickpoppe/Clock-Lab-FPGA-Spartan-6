## ============================================================================
## LAB 1: Internal Clock Synthesizer Constraints (Digilent Atlys Board)
## ============================================================================

## Onboard 100 MHz Oscillator (OSC_CLK)
NET "clk100" LOC = "L15" | IOSTANDARD = LVCMOS33;
NET "clk100" TNM_NET = "TN_clk100";
TIMESPEC "TS_clk100" = PERIOD "TN_clk100" 10.0 ns HIGH 50%;

## ----------------------------------------------------------------------------
## Slide Switches (SW0 .. SW7)
## ----------------------------------------------------------------------------
NET "sw<0>" LOC = "A10" | IOSTANDARD = LVCMOS33; # Manual Reset
NET "sw<1>" LOC = "D14" | IOSTANDARD = LVCMOS33; # Unused
NET "sw<2>" LOC = "C14" | IOSTANDARD = LVCMOS33; # Unused
NET "sw<3>" LOC = "P15" | IOSTANDARD = LVCMOS33; # Unused
NET "sw<4>" LOC = "P12" | IOSTANDARD = LVCMOS33; # Unused
NET "sw<5>" LOC = "R5"  | IOSTANDARD = LVCMOS33; # Unused
NET "sw<6>" LOC = "T5"  | IOSTANDARD = LVCMOS33; # Unused
NET "sw<7>" LOC = "E4"  | IOSTANDARD = LVCMOS33; # Mode Select (60 MHz vs 80 MHz)

# Apply Time-Ignored Group (TIG) to asynchronous input lines
NET "sw<*>" TIG;

## ----------------------------------------------------------------------------
## Diagnostic LEDs (LD0 .. LD7)
## ----------------------------------------------------------------------------
NET "led<0>" LOC = "U18" | IOSTANDARD = LVCMOS33; # DCM 60 MHz Locked Status
NET "led<1>" LOC = "M14" | IOSTANDARD = LVCMOS33; # DCM 80 MHz Locked Status
NET "led<2>" LOC = "N14" | IOSTANDARD = LVCMOS33; # PLL Locked Status
NET "led<3>" LOC = "L14" | IOSTANDARD = LVCMOS33; # Master System Reset Status
NET "led<4>" LOC = "M13" | IOSTANDARD = LVCMOS33; # 1x Fabric Clock Blinker
NET "led<5>" LOC = "D4"  | IOSTANDARD = LVCMOS33; # 4x Test Clock Blinker (Flashes 4x faster)
NET "led<6>" LOC = "P16" | IOSTANDARD = LVCMOS33; # Tied to '0'
NET "led<7>" LOC = "N12" | IOSTANDARD = LVCMOS33; # Tied to '0'

# Apply TIG to status indicator lines as they pass to slower hardware LEDs
NET "led<*>" TIG;

## ----------------------------------------------------------------------------
## Optional HDMI Pins (Commented out - Unused for Lab 1 internal clocking)
## ----------------------------------------------------------------------------
# NET "hdmi_tx_clk_p" LOC = "B6" | IOSTANDARD = TMDS_33;
# NET "hdmi_tx_clk_n" LOC = "A6" | IOSTANDARD = TMDS_33;
# NET "hdmi_tx_p<0>"  LOC = "D8" | IOSTANDARD = TMDS_33;
# NET "hdmi_tx_n<0>"  LOC = "C8" | IOSTANDARD = TMDS_33;
# NET "hdmi_tx_p<1>"  LOC = "C7" | IOSTANDARD = TMDS_33;
# NET "hdmi_tx_n<1>"  LOC = "A7" | IOSTANDARD = TMDS_33;
# NET "hdmi_tx_p<2>"  LOC = "B8" | IOSTANDARD = TMDS_33;
# NET "hdmi_tx_n<2>"  LOC = "A8" | IOSTANDARD = TMDS_33;

